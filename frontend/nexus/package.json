  "preferences": [
    {
      "name": "WORKSPACE_PATH",
      "title": "Workspace path",
      "description": "The workspace path you are going to index",
      "type": "directory",
      "required": true,
      "placeholder": "Users/your-ursername/your/directory/workspace/path"
    },
    {
      "name": "PROVIDER",
      "title": "LLM Provider",
      "description": "The llm provider the user is going to use for his app",
      "type": "dropdown",
      "required": true,
      "default": "openai",
      "data": [
        {
          "title": "Ollama (Local)",
          "value": "ollama"
        },
        {
          "title": "OpenAI",
          "value": "openai"
        }
      ]
    },
    {
      "name": "OPENAI_KEYWORD_GENERATOR_MODEL",
