{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "nexus",
  "title": "Nexus",
  "description": "",
  "icon": "icon.png",
  "author": "manuel_banchero",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "nexus",
      "title": "Nexus",
      "description": "",
      "mode": "view"
    }
